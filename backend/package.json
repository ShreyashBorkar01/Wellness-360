    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.4",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.13",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
